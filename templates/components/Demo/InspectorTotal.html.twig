{% import 'ux_packages/inspector/_shapes.html.twig' as shape %}
<div {{ attributes }} class="total mt-4 grid w-full min-w-0 justify-self-stretch gap-[15px] pt-[10px]" data-demo="total" data-demo-total="{{ this.total }}" aria-label="Total {{ this.total }} euros">
    <div class="between flex items-center justify-between gap-[10px]">{{ shape.bar('40%', 6) }}{{ shape.bar('22%', 6) }}</div>
    <div class="between flex items-center justify-between gap-[10px]">{{ shape.bar('32%', 6) }}{{ shape.bar(express ? '28%' : '15%', 6) }}</div>
    <div class="total-amount flex items-center justify-between gap-[10px] border-t border-[var(--line)] pt-[18px] [&_.ph:last-child]:bg-[#85949f]">{{ shape.bar('38%') }}{{ shape.bar((18 + this.total / 5) ~ '%', 12) }}</div>
</div>
