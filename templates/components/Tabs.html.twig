{%- props
    ## string Define the open Tabs at initial rendering.
    defaultValue = '',
    ## 'horizontal'|'vertical' Define the visual orientation.
    orientation = 'horizontal'
-%}
{%- do provide('tabs.defaultValue', defaultValue) -%}

<div
    data-slot="tabs"
    data-controller="tabs"
    data-tabs-active-tab-value="{{ defaultValue }}"
    data-orientation="{{ orientation }}"
    class="{{ ('gap-1 group/tabs flex data-[orientation=horizontal]:flex-col ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
    {## The default block. -#}
    {% block content %}{% endblock %}
</div>
