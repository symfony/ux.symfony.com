<div class="mb-12 px-6">
    <twig:Browser class="shadow-blur shadow-blur--rainbow w-full max-w-[1140px]">
        <div class="ProductGrid p-4 sm:p-6">
            <div id="product-grid" class="ProductGrid_items">
                {% for item in items %}
                    <twig:ProductGridItem :item="item" />
                {% endfor %}
            </div>
            <div class="grid place-content-center pt-8">
                {{ pagination }}
            </div>
        </div>
    </twig:Browser>
</div>

<section class="py-12">
    <div class="code-description mx-auto max-w-2xl px-6 text-center text-balance">
        <h2>So... how does it work?</h2>
        <p class="leading-7">{{ explanationHint }}</p>
    </div>
</section>
