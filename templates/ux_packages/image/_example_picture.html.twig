<twig:ux:picture class="hero">
    <twig:ux:source
        srcset="/photos/hero-desktop.webp"
        media="(min-width: 800px)"
        type="image/webp"
    />
    <twig:ux:source
        srcset="/photos/hero-mobile.webp"
        type="image/webp"
    />
    <twig:ux:img
        src="/photos/hero-mobile.jpg"
        alt="Hero image"
        width="400"
        height="300"
    />
</twig:ux:picture>
