{% props command, label = null, accent = null %}

<div {{ attributes.defaults({class: 'relative z-[1] flex h-14 w-[min(100%,34rem)] max-w-full flex-row items-center self-center overflow-hidden rounded-full py-2 pr-2 pl-4 max-sm:pr-1.5 max-sm:pl-3 before:content-[""] before:absolute before:inset-0 before:-z-[1] before:block before:bg-black before:opacity-90 before:backdrop-blur-[5px]'}) }}
    data-controller="clipboarder"
    data-clipboarder-source-value="{{ command }}"
>
    <pre
        class="z-4 m-0 min-w-0 flex-1 overflow-x-auto border-0 bg-transparent px-1 outline-none font-mono text-xs text-white [scrollbar-width:none] sm:px-2 sm:text-sm [&::-webkit-scrollbar]:hidden"
        aria-label="{{ label }}"
    ><code class="before:content-['$_'] before:whitespace-pre before:text-(--package-accent)">
        {%- if accent and accent in command -%}
            {%- set command_parts = command|split(accent, 2) -%}
            {{- command_parts[0] -}}<strong class="font-semibold text-(--package-accent)">{{ accent }}</strong>{{- command_parts[1]|default('') -}}
        {%- else -%}
            {{- command -}}
        {%- endif -%}
    </code></pre>
    <button
        type="button"
        class="relative z-4 ms-5 grid size-10 shrink-0 place-items-center rounded-full border-0 bg-transparent p-0 text-(--package-accent) transition-colors duration-150 hover:bg-[color-mix(in_oklch,var(--package-accent)_15%,transparent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--package-accent) max-sm:ms-2"
        aria-label="Copy command"
        data-action="clipboarder#copy"
    >
        <twig:ux:icon name="copy"/>
    </button>
</div>
