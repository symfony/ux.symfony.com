{# @prop label string Address shown in the window chrome #}
{%- props label = null -%}

<div {{ attributes.defaults({class: 'mt-24 overflow-hidden rounded-xl border border-body-text/15 bg-body'}) }}>
    <div class="flex items-center gap-2 border-b border-body-text/10 bg-subtle px-4 py-3 font-mono text-[0.65rem] text-muted" aria-hidden="true">
        <span class="size-2 rounded-full bg-body-text/20"></span>
        <span class="size-2 rounded-full bg-body-text/20"></span>
        <span class="size-2 rounded-full bg-body-text/20"></span>
        {%- if label -%}
            <span class="ml-3 truncate">{{ label }}</span>
        {%- endif -%}
    </div>
    <div class="overflow-x-auto px-6 py-16 sm:px-10 sm:py-20">
        {% block content %}{% endblock %}
    </div>
</div>
