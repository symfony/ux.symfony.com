{% extends 'ux_packages/package.html.twig' %}

{% block package_header %}
    {% component PackageHeader with {
        package: 'translator',
        eyebrowText: 'JavaScript-enabled Translation',
    } %}
        {% block title_header %}
            Translations directly imported in <em>JavaScript</em>
        {% endblock %}

        {% block sub_content %}
            Write & manage your translations like you always do. Then use them just as easily in JS.
        {% endblock %}
    {% endcomponent %}
{% endblock %}

{% block package_features %}
    {% set translator_features = [
        {
            icon: 'lucide:languages',
            title: 'The same <strong>catalogues</strong>',
            description: 'Translations you already wrote, now in JavaScript.',
        },
        {
            icon: 'lucide:file-down',
            title: 'Dumped at <strong>build time</strong>',
            description: 'Generated files, no runtime lookup.',
        },
        {
            icon: 'lucide:scissors',
            title: 'Only what you <strong>use</strong>',
            description: 'Tree-shakeable domains keep the bundle small.',
        },
        {
            icon: 'lucide:braces',
            title: 'Typed <strong>parameters</strong>',
            description: 'TypeScript types generated from your catalogues.',
        },
        {
            icon: 'lucide:globe',
            title: 'Intl <strong>ready</strong>',
            description: 'Pluralisation and locale switching included.',
        },
    ] %}
    <twig:FeaturesCluster
        :items="translator_features"
        title="What Translator gives you"
        titleId="translator-overview-title"
    />
{% endblock %}

{% block package_highlights %}
    {% set tr_dump %}var/translations/
├── index.js
└── index.d.ts{% endset %}
    {% set tr_trans %}import { trans } from '@symfony/ux-translator';
import { HELLO } from '../translations/messages';

trans(HELLO, { name: 'Hugo' });{% endset %}
    {% set tr_shake %}import { TASK_CREATED } from '../translations';

// the validators domain is never
// imported, so it never ships{% endset %}

    <twig:Package:Highlights
        eyebrow="Dumped at build time"
        title="How the catalogues <strong>get there</strong>."
        intro="Nothing is fetched at runtime. A cache warmer writes your catalogues to disk, and your JavaScript imports them like any other module."
        :items="[
            {
                icon: 'lucide:file-down',
                title: 'Written to <strong>disk</strong>',
                description: 'Every domain and every locale you configured ends up in one generated module, types included.',
                code: tr_dump,
                language: 'bash',
            },
            {
                icon: 'lucide:languages',
                title: 'The same <strong>trans()</strong>',
                description: 'Placeholders, pluralisation and locale fallbacks behave the way they do in Twig.',
                code: tr_trans,
                language: 'javascript',
            },
            {
                icon: 'lucide:scissors',
                title: 'Only what you <strong>import</strong>',
                description: 'Message ids are named exports, so a bundler drops the domains your code never touches.',
                code: tr_shake,
                language: 'javascript',
            },
        ]"
    />
{% endblock %}

{% block code_block_left %}
    <twig:CodeBlock filename="translations/messages+intl-icu.en.yaml" height="300px"/>
{% endblock %}

{% block code_block_right %}
    <twig:CodeBlock filename="translations/messages+intl-icu.fr.yaml" height="300px"/>
{% endblock %}

{% block demo_title %}UX Translator{% endblock %}

{% block demo_content %}

        {% embed 'ux_packages/translator/_translator_demo_block.html.twig' with {
            message: 'hello',
        } %}
        {% endembed %}

        {% embed 'ux_packages/translator/_translator_demo_block.html.twig' with {
            message: 'say_hello',
            parameters: {
                name: 'Fabien',
            },
        } %}
            {% block parameters %}
                <div class="mb-2">
                    <twig:Form:Label for="say_hello-name">Name</twig:Form:Label>
                    <twig:Form:Input id="say_hello-name"
                           type="text" name="name" value="Fabien"
                           data-translator-demo-block-target="parameters"
                           data-action="translator-demo-block#render"
                    />
                </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ux_packages/translator/_translator_demo_block.html.twig' with {
            message: 'invitation_title',
            parameters: {
                organizer_gender: 'Fabien',
                organizer_name: 'Clara',
            },
        } %}
            {% block parameters %}
                <div class="mb-2">
                    <twig:Form:Label for="invitation_title-organizer_gender">Gender</twig:Form:Label>
                    <twig:Form:Select id="invitation_title-organizer_gender"
                        name="organizer_gender"
                        data-translator-demo-block-target="parameters"
                        data-action="translator-demo-block#render"
                    >
                        <option value="female" selected>Female</option>
                        <option value="male">Male</option>
                        <option value="multiple">Multiple</option>
                        <option value="trans">Trans</option>
                    </twig:Form:Select>
                </div>
                <div class="mb-2">
                    <twig:Form:Label for="invitation_title-organizer_name">Name</twig:Form:Label>
                    <twig:Form:Input id="invitation_title-organizer_name"
                           name="organizer_name"
                           value="Clara"
                           data-translator-demo-block-target="parameters"
                           data-action="translator-demo-block#render"
                    />
                </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ux_packages/translator/_translator_demo_block.html.twig' with {
            message: 'num_of_apples',
            parameters: {
                apples: 2,
            },
        } %}
            {% block parameters %}
                <div class="mb-2">
                    <twig:Form:Label for="num_of_apples-apples">Count</twig:Form:Label>
                    <twig:Form:Input id="num_of_apples-apples"
                           name="apples" type="number" min="0" max="5" value="2"
                           data-translator-demo-block-target="parameters"
                           data-action="translator-demo-block#render"
                    />
                </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ux_packages/translator/_translator_demo_block.html.twig' with {
            message: 'finish_place',
            parameters: {
                place: 2,
            },
        } %}
            {% block parameters %}
                <div class="mb-2">
                    <twig:Form:Label for="finish_place-place">Place</twig:Form:Label>
                    <twig:Form:Input id="finish_place-place"
                           name="place" type="number" min="0" max="5" value="1"
                           data-translator-demo-block-target="parameters"
                           data-action="translator-demo-block#render"
                    />
                </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ux_packages/translator/_translator_demo_block.html.twig' with {
            message: 'published_at',
            parameters: {
                publication_date: '2023-04-27 08:12',
            },
        } %}
            {% block parameters %}
                <div class="mb-2">
                    <twig:Form:Label for="published_at-publication_date">Date</twig:Form:Label>
                    <twig:Form:Input id="published_at-publication_date"
                           name="publication_date" type="datetime-local" value="2023-04-27 08:12"
                           data-translator-demo-block-target="parameters"
                           data-action="translator-demo-block#render"
                    />
                </div>
            {% endblock %}
        {% endembed %}

         {% embed 'ux_packages/translator/_translator_demo_block.html.twig' with {
            message: 'progress',
            parameters: {
                progress: 42,
            },
        } %}
            {% block parameters %}
                <div class="mb-2">
                    <twig:Form:Label for="progress-progress">Place</twig:Form:Label>
                    <input id="progress-progress" class="w-full accent-[#222]"
                           name="progress" type="range" min="0" max="100" value="42"
                           data-translator-demo-block-target="parameters"
                           data-action="translator-demo-block#render"
                    >
                </div>
            {% endblock %}
        {% endembed %}

        {% embed 'ux_packages/translator/_translator_demo_block.html.twig' with {
            message: 'value_of_object',
            parameters: {
                price: 30,
            },
        } %}
            {% block parameters %}
                <div class="mb-2">
                    <twig:Form:Label for="value_of_object-price">Price</twig:Form:Label>
                    <twig:Form:Input id="value_of_object-price"
                           name="price" type="number" min="1"  value="30" step="0.1"
                           data-translator-demo-block-target="parameters"
                           data-action="translator-demo-block#render"
                    />
                </div>
            {% endblock %}
        {% endembed %}

{% endblock %}
