{% extends 'toolkit/kit_page.html.twig' %}

{% set trail = [
    {label: kit.manifest.name},
] %}
{% set meta = {
    title: 'UX Toolkit - Kits - ' ~ kit.manifest.name,
    description: kit.manifest.description,
    canonical: url('app_toolkit_kit', {kitId: kit_id}),
    hierarchy: ['Kits']|merge(trail|column('label')),
    social: {
        title: 'UX Toolkit - Kits - ' ~ kit.manifest.name,
        description: kit.manifest.description,
        image: {
            url: absolute_url(asset(package.getSocialImage('1200x675'))),
            type: 'image/png',
            width: 1200,
            height: 675,
            alt: package.humanName ~ ' - Kit ' ~ kit.manifest.name,
        },
    },
} %}

{% block kit_main %}
    {{ include('toolkit/_kit_breadcrumb.html.twig', {trail: trail}) }}

    <div class="Wysiwyg">
        {{- kit.installAsMarkdown|markdown_to_html -}}
    </div>
{% endblock %}
