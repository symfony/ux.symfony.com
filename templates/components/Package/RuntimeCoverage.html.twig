{% props package, items %}

<twig:Box
    color="{{ package.tileColor }}"
    gradient="{{ package.gradient }}"
    radius="xl"
    titleTag="h3"
    :alignContentTop="true"
    logoSize="4rem"
>
    <twig:block name="logo">
        <img
            width="36"
            height="36"
            src="{{ asset('images/ux_packages/' ~ package.imageFilename) }}"
            alt=""
        >
    </twig:block>

    <twig:block name="title">
        <a href="{{ url(package.route) }}" class="stretched-link text-body-text no-underline">{{ package.humanName }}</a>
    </twig:block>

    <twig:block name="description">
        <ul class="mt-5 grid list-none gap-3 p-0 text-sm leading-relaxed text-body-text/75">
            {% for item in items %}
                <li class="flex items-start gap-3">
                    <twig:ux:icon name="bi:check-circle" class="mt-0.5 size-4 shrink-0 text-(--package-primary-text)" aria-hidden="true" />
                    <span>{{ item }}</span>
                </li>
            {% endfor %}
        </ul>
    </twig:block>
</twig:Box>
