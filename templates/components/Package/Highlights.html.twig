{# @prop items array Each entry takes `icon`, an HTML `title`, a `description`, optional `code` + `language` + `colorSwatches`, optional `screenshots` (each with `src`, `width`, `height`, `alt`, HTML `caption`), and `wide` to span the whole row #}
{# @prop title string Section heading HTML; wrap the accented words in `<strong>` #}
{# @prop eyebrow string Small uppercase label above the heading #}
{# @prop intro string Sentence under the heading #}
{# @prop id string Anchor target for the section #}
{# @prop tone string Background tone passed to Package:Section #}
{# @prop columns int Items per row on large screens, 2 or 3 #}
{%- props items, title, eyebrow = null, intro = null, id = null, tone = 'default', columns = 3 -%}

<twig:Package:Section id="{{ id }}" tone="{{ tone }}">
    <twig:Package:SectionHeading eyebrow="{{ eyebrow }}" title="{{ title }}">
        {%- if intro -%}
            <p>{{ intro|raw }}</p>
        {%- endif -%}
    </twig:Package:SectionHeading>

    <div class="grid gap-x-8 gap-y-14 {{ columns == 2 ? 'lg:grid-cols-2' : 'lg:grid-cols-3' }}">
        {% for item in items %}
            <article class="flex min-w-0 flex-col {{ item.wide|default(false) ? 'lg:col-span-full' }}">
                <twig:ux:icon name="{{ item.icon }}" class="size-8 fill-none stroke-[1.6] text-(--package-primary-text)" aria-hidden="true" />

                <h3 class="m-0 mt-6 font-title text-2xl font-bold leading-tight tracking-[-.02em] text-balance [&_strong]:text-(--package-primary-text)">{{ item.title|raw }}</h3>

                <p class="m-0 mt-4 leading-[1.7] text-body-text/80 text-balance [&_a]:text-(--package-primary-text) [&_a]:underline [&_a]:decoration-current/35 [&_a]:underline-offset-[.2em] [&_a:hover]:decoration-current">{{ item.description|raw }}</p>

                {% if item.code|default %}
                    <twig:CodeBlockInline
                        :code="item.code"
                        language="{{ item.language|default('php') }}"
                        :colorSwatches="item.colorSwatches|default(false)"
                        class="mt-8"
                    />
                {% endif %}

                {% if item.screenshots|default %}
                    <div class="mt-8 grid gap-x-6 gap-y-8 sm:grid-cols-2">
                        {% for screenshot in item.screenshots %}
                            <figure class="m-0">
                                <a href="{{ screenshot.src }}" target="_blank" class="block overflow-hidden rounded-xl border border-white/10 shadow-lg">
                                    <img src="{{ screenshot.src }}" alt="{{ screenshot.alt }}" width="{{ screenshot.width }}" height="{{ screenshot.height }}" class="block h-auto w-full" loading="lazy">
                                </a>
                                <figcaption class="mt-3 text-sm leading-[1.6] text-body-text/70">{{ screenshot.caption|raw }}</figcaption>
                            </figure>
                        {% endfor %}
                    </div>
                {% endif %}
            </article>
        {% endfor %}
    </div>
</twig:Package:Section>
