{% extends 'toolkit/kit_page.html.twig' %}

{% set title = 'Blocks - ' ~ kit.manifest.name ~ ' Kit' %}
{% set description = "Ready-to-use blocks from the UX Toolkit #{kit.manifest.name} kit." %}
{% set meta = {
    title: title,
    description: description,
    canonical: url('app_icons'),
    social: {
        title: title,
        description: description,
        image: {
            url: absolute_url(asset(package.getSocialImage('1200x675'))),
            type: 'image/png',
            width: 1200,
            height: 675,
            alt: package.humanName ~ ' - Kit ' ~ kit.manifest.name,
        },
    },
} %}

{% block kit_main %}
    <twig:Toolkit:Breadcrumb class="mb-2">
        <twig:Toolkit:Breadcrumb:Item>
            <twig:Toolkit:Breadcrumb:Link href="{{ path('app_toolkit') }}">UX Toolkit</twig:Toolkit:Breadcrumb:Link>
        </twig:Toolkit:Breadcrumb:Item>
        <twig:Toolkit:Breadcrumb:Separator />
        <twig:Toolkit:Breadcrumb:Item>
            <twig:Toolkit:Breadcrumb:Link href="{{ path('app_toolkit', {_fragment: 'kits'}) }}">Kits</twig:Toolkit:Breadcrumb:Link>
        </twig:Toolkit:Breadcrumb:Item>
        <twig:Toolkit:Breadcrumb:Separator />
        <twig:Toolkit:Breadcrumb:Item>
            <twig:Toolkit:Breadcrumb:Link href="{{ path('app_toolkit_kit', {kitId: kit_id}) }}">{{ kit.manifest.name }}</twig:Toolkit:Breadcrumb:Link>
        </twig:Toolkit:Breadcrumb:Item>
        <twig:Toolkit:Breadcrumb:Separator />
        <twig:Toolkit:Breadcrumb:Item active>Blocks</twig:Toolkit:Breadcrumb:Item>
    </twig:Toolkit:Breadcrumb>

    <div class="Wysiwyg">
        <h1>Blocks</h1>
        <p>Ready-to-use, copy-paste page sections built from the kit's components.</p>
    </div>

    <div class="mt-10 space-y-16">
        {% for entry in sections %}
            <section>
                <div class="Wysiwyg mb-6">
                    <h2>
                        <a href="{{ path('app_toolkit_block_section', {kitId: kit_id, section: entry.section.slug}) }}"
                           class="no-underline hover:underline">{{ entry.section.name }}</a>
                    </h2>
                </div>
                <div class="space-y-10">
                    {% for variant in entry.variants %}
                        {{ include('toolkit/_block_preview.html.twig', {variant: variant, kit_id: kit_id}) }}
                    {% endfor %}
                </div>
            </section>
        {% else %}
            <div class="Wysiwyg">
                <p>This kit has no blocks yet.</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}
