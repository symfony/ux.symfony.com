{% extends 'base.html.twig' %}

{% set meta = {
    title: 'Upload demos',
    description: 'Explore field styles, plain forms, Turbo, LiveComponent, and theming with Symfony UX Upload.',
    canonical: url('app_demo_upload'),
} %}

{% block content %}
    <section class="bg-subtle py-16 md:py-24">
        <div class="mx-auto max-w-[1400px] px-6 md:px-12">
            <p class="eyebrows mb-4 text-center"><a href="{{ path('app_demos') }}">Demos</a> / Upload</p>
            <h1 class="text-center">Upload demos</h1>
            <p class="mx-auto mt-5 max-w-2xl text-center text-lg leading-8 text-body-text/75">
                Pick a field style, plug it into a plain form, Turbo, or LiveComponent, then make it your own.
            </p>
        </div>
    </section>

    <section class="mx-auto max-w-[1400px] px-6 py-16 md:px-12 md:py-24">
        {{ include('demos/upload/_cards.html.twig') }}
    </section>
{% endblock %}
