{% extends 'base.html.twig' %}

{% set meta = {
    title: package.seoTitle,
    description: package.description,
    canonical: url(package.route),
    social: {
        title: package.socialTitle,
        description: package.description|striptags,
        image: {
            url: absolute_url(asset(package.getSocialImage('1200x675'))),
            type: 'image/png',
            width: 1200,
            height: 675,
            alt: package.humanName ~ ' - Component Icon',
        },
    },
} %}

{% block body_attributes %} style="{{ include('ux_packages/_package_tokens.html.twig')|trim }}"{% endblock %}

{% block header %}
    {{ include('_header.html.twig', {theme: 'package'}) }}
{% endblock %}

{% block content %}

<article class="dark:[--package-primary-text:var(--package-accent)]">
    {% block package_header %}{% endblock %}

    {% block package_features %}{% endblock %}

    {% block package_content %}
        {% set content_heading = block('package_content_heading') %}
        {% set content_code_blocks = block('package_code_blocks') %}
        {% set content_demo = block('package_demo') %}
        <twig:Package:Section tone="subtle">{{ content_heading|raw }}{{ content_code_blocks|raw }}{{ content_demo|raw }}</twig:Package:Section>
    {% endblock %}

    {% block package_highlights %}{% endblock %}

    {% block package_install %}
        <twig:Package:Section tone="deep">
            <twig:Package:SectionHeading centered title="Install <strong>{{ package.humanName }}</strong>." />
            {{ include('ux_packages/_package_install.html.twig', {
                package: package,
            }) }}
        </twig:Package:Section>
    {% endblock %}

    {% block package_suggestions %}
        <twig:PackageSuggestions package="{{ package }}" />
    {% endblock %}

    {% block package_links %}
        {{ include('ux_packages/_package_links.html.twig', {
            package: package,
        }) }}
    {% endblock %}

</article>

{% endblock %}

{% block package_content_heading %}
    <twig:Package:SectionHeading
        eyebrow="{{ package.tagLine }}"
        title="Add <strong>{{ package.humanName }}</strong> to your app."
    >{{ package.description|markdown_to_html }}</twig:Package:SectionHeading>
{% endblock %}

{% block package_code_blocks %}
    {% set code_left = block('code_block_left') %}
    {% set code_right = block('code_block_right') %}
    <twig:Package:CodeFlow arrows :trailingArrow="block('demo_title') is defined">
        <twig:block name="source">{{ code_left|raw }}</twig:block>
        <twig:block name="result">{{ code_right|raw }}</twig:block>
    </twig:Package:CodeFlow>
{% endblock %}

{% block package_demo %}
    {% if block('demo_title') is defined %}
        {% set demo_title = block('demo_title') %}
        {% set demo_content = block('demo_content') %}
        <div id="demo" class="mt-24 scroll-mt-20">
            {% embed 'ux_packages/_package_demo.html.twig' %}
                {% block title %}{{ demo_title|raw }}{% endblock %}
                {% block content %}{{ demo_content|raw }}{% endblock %}
            {% endembed %}
        </div>
    {% endif %}
{% endblock %}

{% block code_block_left %}{% endblock %}
{% block code_block_right %}{% endblock %}
