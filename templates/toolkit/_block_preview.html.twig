{# One block variant: its description, a live desktop-width preview, and — when show_install is true —
   the copy-paste install command. Shared by the Blocks index and the block section page. #}
<div class="space-y-4">
    {% if variant.recipe.description %}
        <div class="Wysiwyg">
            <p>{{ variant.recipe.description }}</p>
        </div>
    {% endif %}

    {% if variant.preview_url %}
        {{ include('toolkit/docs/_preview.html.twig', {previewUrl: variant.preview_url, initial_width: 1280, fit: true}) }}
    {% endif %}

    {% if show_install|default(false) %}
        <twig:CodeBlockInline code="php bin/console ux:install {{ variant.recipe.name }} --kit {{ kit_id }}" language="shell" />
    {% endif %}
</div>
