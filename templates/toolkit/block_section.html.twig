{% extends 'toolkit/kit_page.html.twig' %}

{% set title = section.name ~ ' - Blocks - ' ~ kit.manifest.name ~ ' Kit' %}
{% set description = "The #{section.name} blocks from the UX Toolkit #{kit.manifest.name} kit." %}
{% set meta = {
    title: title,
    description: description,
    canonical: url('app_icons'),
    social: {
        title: title,
        description: description,
        image: {
            url: absolute_url(asset(package.getSocialImage('1200x675'))),
            type: 'image/png',
            width: 1200,
            height: 675,
            alt: package.humanName ~ ' - Kit ' ~ kit.manifest.name,
        },
    },
} %}

{% block kit_main %}
    <twig:Toolkit:Breadcrumb class="mb-2">
        <twig:Toolkit:Breadcrumb:Item>
            <twig:Toolkit:Breadcrumb:Link href="{{ path('app_toolkit') }}">UX Toolkit</twig:Toolkit:Breadcrumb:Link>
        </twig:Toolkit:Breadcrumb:Item>
        <twig:Toolkit:Breadcrumb:Separator />
        <twig:Toolkit:Breadcrumb:Item>
            <twig:Toolkit:Breadcrumb:Link href="{{ path('app_toolkit', {_fragment: 'kits'}) }}">Kits</twig:Toolkit:Breadcrumb:Link>
        </twig:Toolkit:Breadcrumb:Item>
        <twig:Toolkit:Breadcrumb:Separator />
        <twig:Toolkit:Breadcrumb:Item>
            <twig:Toolkit:Breadcrumb:Link href="{{ path('app_toolkit_kit', {kitId: kit_id}) }}">{{ kit.manifest.name }}</twig:Toolkit:Breadcrumb:Link>
        </twig:Toolkit:Breadcrumb:Item>
        <twig:Toolkit:Breadcrumb:Separator />
        <twig:Toolkit:Breadcrumb:Item>
            <twig:Toolkit:Breadcrumb:Link href="{{ path('app_toolkit_kit_blocks', {kitId: kit_id}) }}">Blocks</twig:Toolkit:Breadcrumb:Link>
        </twig:Toolkit:Breadcrumb:Item>
        <twig:Toolkit:Breadcrumb:Separator />
        <twig:Toolkit:Breadcrumb:Item active>{{ section.name }}</twig:Toolkit:Breadcrumb:Item>
    </twig:Toolkit:Breadcrumb>

    <div class="Wysiwyg">
        <h1>{{ section.name }}</h1>
    </div>

    <div class="mt-8 space-y-12">
        {% for variant in variants %}
            {{ include('toolkit/_block_preview.html.twig', {variant: variant, kit_id: kit_id, show_install: true}) }}
        {% endfor %}
    </div>
{% endblock %}
