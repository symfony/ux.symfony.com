<twig:Package:Section tone="subtle">
    <twig:Package:SectionHeading centered title="Keep <strong>{{ package.humanName }}</strong> at hand.">
        <p>Documentation, the people behind it, and where to ask when something does not behave.</p>
    </twig:Package:SectionHeading>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {% set docs_url = docs_url|default(null) %}
            {% set docs_text = docs_text|default('Symfony UX ' ~ package.humanName ~ ' Docs') %}
            {% if package.shouldShowDocsLink or docs_url %}
                <twig:DocsLink
                    title="Documentation"
                    text="{{ docs_text }}"
                    url="{{ docs_url|default(package.officialDocsUrl) }}"
                    icon="symfony"
                />
            {% endif %}
            {% if package.screencastLink %}
                <twig:DocsLink
                    title="Screencasts"
                    text="{{ package.screencastLinkText }}"
                    url="{{ package.screencastLink }}"
                    icon="symfonycast"
                />
                <twig:DocsLink
                    title="Community"
                    text="Feedback · support · contributions."
                    url="https://github.com/symfony/ux"
                    icon="github"
                />
            {% else %}
                <twig:DocsLink
                    title="Community"
                    text="Feedback · support · contributions."
                    url="https://github.com/symfony/ux"
                    icon="github"
                />
                <twig:DocsLink
                    title="Support"
                    text="Get help with Symfony UX {{ package.humanName }}"
                    url="{{ url('app_support') }}"
                    icon="raphael:help"
                />
            {% endif %}

    </div>
</twig:Package:Section>
