<div class="PackageHeader bg-(--package-accent) pt-12 text-(--package-accent-ink)">
    <div class="max-w-[1400px] mx-auto px-6 pt-6 md:px-12 md:pt-12 relative">

        <p class="eyebrows text-center mt-12 mb-4 opacity-85">{{ eyebrowText|raw }}</p>

        <h1 class="text-center text-balance font-medium
                   [&_em]:inline-flex [&_em]:font-normal [&_em]:not-italic [&_em]:-skew-x-16 [&_em]:scale-y-95
                   [&_strong]:font-bold [&_strong]:underline [&_strong]:decoration-(--color-accent)/40 [&_strong]:decoration-[.09em] [&_strong]:underline-offset-[.09em]">
            {%- block title_header -%}
                {{ title|default }}
            {%- endblock -%}
        </h1>

        <div class="flex justify-center">
            <p class="Wysiwyg text-center mt-4 pb-4 w-1/2 text-balance max-xl:w-3/5 max-md:w-4/5">
                {%- block sub_content -%}
                    {{ subtitle|default }}
                {%- endblock -%}
            </p>
        </div>

        {% block header_action_area %}
        <div class="relative translate-y-1/2">
            <div class="flex flex-wrap items-center justify-center gap-4 max-sm:*:w-full">
                {% if command %}
                    <twig:TerminalCommand
                        aria-label="Composer command to install {{ package.humanName }}"
                        command="{{ package.composerRequireCommand }}"
                        accent="{{ package.composerName|split('/')|last }}"
                    />
                {% endif %}

                {% block header_primary_action %}{% endblock %}
            </div>

            <nav
                class="absolute inset-x-0 top-[calc(100%+1.25rem)] flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm/6 text-(--package-primary-text) [&_a]:inline-flex [&_a]:items-center [&_a]:gap-1.5 [&_a:hover]:underline [&_a:hover]:underline-offset-[.2em]"
                aria-label="{{ package.humanName }} resources"
            >
                {% block header_links %}
                    {% if demosUrl %}
                        <a href="{{ demosUrl }}">
                            <twig:ux:icon name="browser" class="Icon size-4" />
                            Live Demos
                        </a>
                    {% endif %}
                    {% if package.shouldShowDocsLink %}
                        <a href="{{ package.officialDocsUrl }}">
                            <twig:ux:icon name="symfony" class="Icon size-4" />
                            Documentation
                        </a>
                    {% endif %}
                    <a href="{{ package.githubRepositoryUrl }}">
                        <twig:ux:icon name="github" class="Icon size-4" />
                        Repository
                    </a>
                    <a href="{{ path('app_support') }}">
                        <twig:ux:icon name="support" class="Icon size-4" />
                        Support
                    </a>
                {% endblock %}
            </nav>
        </div>
        {% endblock %}
    </div>
</div>

{# Reserves the room the translated actions and their links take below the header. #}
<div class="h-32 sm:h-18" aria-hidden="true"></div>
