<div class="group relative flex flex-col gap-4 self-stretch rounded-xl border border-surface bg-body p-6 transition-all duration-250 ease-in-out hover:-translate-y-1 hover:shadow-lg">
    <div class="flex size-10 shrink-0 items-center justify-center [&>svg]:h-auto [&>svg]:w-full">
        {% block logo %}{% endblock %}
    </div>
    <div class="flex flex-1 flex-col gap-2">
        <h2 class="m-0 font-title text-xl font-bold leading-normal">
            {% block title %}{% endblock %}
        </h2>
        <p class="m-0 text-sm leading-6 text-body-text/70">
            {% block description %}{% endblock %}
        </p>
    </div>
</div>
