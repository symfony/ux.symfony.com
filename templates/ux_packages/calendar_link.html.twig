{% extends 'ux_packages/package.html.twig' %}

{% block package_header %}
    {% component PackageHeader with {
        package: 'calendar-link',
        eyebrowText: 'Add to Calendar links',
    } %}
        {% block title_header %}
            Save the date, <em>anywhere</em>
        {% endblock %}

        {% block sub_content %}
            Let users add your events to their calendar of choice in one click.
        {% endblock %}
    {% endcomponent %}
{% endblock %}

{% block package_features %}
    {% set calendar_link_features = [
        {
            icon: 'lucide:calendar-plus',
            title: 'One-click <strong>add</strong>',
            description: 'Visitors save your event without copying anything.',
        },
        {
            icon: 'lucide:layout-grid',
            title: 'Every <strong>provider</strong>',
            description: 'Google, Outlook, Yahoo and iCalendar files.',
        },
        {
            icon: 'lucide:repeat',
            title: 'Recurring <strong>events</strong>',
            description: 'Daily, weekly or custom repeat rules.',
        },
        {
            icon: 'lucide:globe',
            title: 'Timezone <strong>correct</strong>',
            description: 'Dates land right wherever the visitor is.',
        },
        {
            icon: 'lucide:code',
            title: 'One Twig <strong>function</strong>',
            description: 'ux_calendar_links() returns every link.',
        },
    ] %}
    <twig:FeaturesCluster
        :items="calendar_link_features"
        title="What CalendarLink gives you"
        titleId="calendar-link-overview-title"
    />
{% endblock %}

{% block package_content %}
    {% set examples = [
        {
            tone: 'subtle',
            title: 'A simple event',
            reversed: false,
            event: symfonyCon,
            prose: 'Create a `CalendarEvent` with a title, a start and an end date, and optionally a `location` and a `description`.

Then call `ux_calendar_links(event)` in your Twig template to get one link per registered provider.',
            code: 'php_simple',
        },
        {
            tone: 'default',
            title: 'A recurring, all-day event',
            reversed: true,
            event: victoryDay,
            prose: 'For events that repeat on a fixed schedule, birthdays, public holidays, weekly team meetings, you do not want people adding them by hand every time.

Set `allDay: true` when the event spans the whole day, and pass a `CalendarRecurrence` to let the calendar handle the repetition.

> [!NOTE]
> Recurrence is honored by Google Calendar and the `.ics` file only.',
            code: 'php_recurring',
        },
        {
            tone: 'subtle',
            title: 'An event with a reminder',
            reversed: false,
            event: bloodDonation,
            prose: 'Having the event in the calendar is a good start, but some appointments really need a heads-up.

Pass one or more `CalendarReminder` instances to warn people ahead of time: a day before, an hour before, whatever the event deserves.

> [!NOTE]
> Reminders are honored by the `.ics` file only.',
            code: 'php_reminder',
        },
    ] %}

    {% set php_simple %}$event = new CalendarEvent(
    title: 'SymfonyCon Warsaw 2026',
    start: new \DateTimeImmutable(
        '2026-11-26 09:00', $timezone,
    ),
    end: new \DateTimeImmutable(
        '2026-11-27 18:00', $timezone,
    ),
    location: 'Hilton Warsaw Hotel',
);{% endset %}

    {% set php_recurring %}$event = new CalendarEvent(
    title: 'Victory in Europe Day',
    start: new \DateTimeImmutable(
        '2025-05-08', $timezone,
    ),
    end: new \DateTimeImmutable(
        '2025-05-09', $timezone,
    ),
    allDay: true,
    recurrence: CalendarRecurrence::yearly(),
);{% endset %}

    {% set php_reminder %}$event = new CalendarEvent(
    title: 'Blood donation',
    start: new \DateTimeImmutable(
        '2025-06-12 14:00', $timezone,
    ),
    end: new \DateTimeImmutable(
        '2025-06-12 15:00', $timezone,
    ),
    reminders: [
        CalendarReminder::before(
            days: 1,
            description: 'Eat and drink well.',
        ),
        CalendarReminder::before(
            hours: 2,
            description: 'Time to go!',
        ),
    ],
);{% endset %}

    {% set snippets = {
        php_simple: php_simple,
        php_recurring: php_recurring,
        php_reminder: php_reminder,
    } %}

    {% for example in examples %}
        {% set body %}
            {% if loop.first %}
                <twig:Package:SectionHeading
                    eyebrow="One object, every calendar"
                    title="Describe the event <strong>once</strong>."
                >
                    <p>A <code>CalendarEvent</code> carries the dates and everything optional around them. The Twig function turns it into one link per provider, and the buttons below are the real thing.</p>
                </twig:Package:SectionHeading>
            {% endif %}

            <div class="grid items-center gap-x-16 gap-y-10 lg:grid-cols-2 [&_.Terminal]:max-h-[26rem]">
                <div class="Wysiwyg min-w-0 {{ example.reversed ? 'lg:order-2' : '' }}">
                    <twig:Package:SectionTitle size="md" title="{{ example.title }}" class="mb-6" />
                    {{ example.prose|markdown_to_html }}
                </div>

                <div class="min-w-0">
                    <twig:CodeBlockInline :code="snippets[example.code]" language="php" />

                    <p class="mt-8 mb-3 font-title text-xs font-semibold font-stretch-semi-condensed uppercase tracking-[.12em] text-(--package-primary-text)">Try the links it produces</p>
                    {{ include('ux_packages/calendar_link/_link_buttons.html.twig', {event: example.event}) }}
                </div>
            </div>
        {% endset %}

        <twig:Package:Section tone="{{ example.tone }}">{{ body }}</twig:Package:Section>
    {% endfor %}
{% endblock %}
