{% extends 'ux_packages/package.html.twig' %}

{% block package_header %}
    {% component PackageHeader with {
        package: 'turbo',
        eyebrowText: 'Speed of an SPA',
    } %}
        {% block title_header %}
            Turbo your <em>website</em>
        {% endblock %}

        {% block sub_content %}
            The speed of a single-page web app without writing any JavaScript,
            courtesy of <a href="https://turbo.hotwired.dev/" rel="external noopener noreferrer">Turbo</a>
        {% endblock %}

    {% endcomponent %}
{% endblock %}

{% block package_features %}
    {% set turbo_features = [
        {
            icon: 'lucide:gauge',
            title: 'Turbo <strong>Drive</strong>',
            description: 'Links and forms become Ajax, no full reloads.',
        },
        {
            icon: 'lucide:frame',
            title: 'Turbo <strong>Frames</strong>',
            description: 'Update one region of the page in place.',
        },
        {
            icon: 'lucide:layers',
            title: 'Turbo <strong>Streams</strong>',
            description: 'Append, replace or remove any element from PHP.',
        },
        {
            icon: 'lucide:radio',
            title: 'Real time with <strong>Mercure</strong>',
            description: 'Broadcast Doctrine changes to every open tab.',
        },
        {
            icon: 'lucide:smartphone',
            title: 'Native <strong>ready</strong>',
            description: 'The same app, wrapped by Hotwire Native.',
        },
    ] %}
    <twig:FeaturesCluster
        :items="turbo_features"
        title="What Turbo gives you"
        titleId="turbo-overview-title"
    />
{% endblock %}

{% block package_content %}
    {% set turbo_docs_url = 'https://symfony.com/bundles/ux-turbo/current/index.html' %}

        {% set turbo_drive %}
        <div class="grid grid-cols-12 gap-x-6">
            <div class="col-span-12 md:col-span-6 md:order-2">
                <div class="md:px-12">
                    <twig:Package:SectionHeading title="Turbo <strong>Drive</strong>.">
                        Transform all link clicks and form submits into Ajax
                        calls to get that single-page-application feel.
                    </twig:Package:SectionHeading>
                    <div class="rounded-md border bg-surface p-4">
                        <p class="m-0 text-sm leading-6">
                            <twig:ux:icon name="arrow-left" />
                            Click any links on this site or submit this form.
                            Zero full page refreshes!
                        </p>
                    </div>
                    {% set drive_docs = [
                        {title: 'Getting started', url: turbo_docs_url ~ '#getting-started-with-turbo-drive'},
                        {title: 'Meta tags', url: turbo_docs_url ~ '#meta-tags'},
                    ] %}
                    <twig:DocumentationLinks
                        :links="drive_docs"
                        label="Documentation for Turbo Drive"
                    />
                </div>
            </div>
            <div class="col-span-12 md:col-span-6 md:order-1">
                {% embed 'ux_packages/_package_demo.html.twig' %}
                    {% block title %}
                        Turbo Drive Demo
                    {% endblock %}
                    {% block content %}
                        {% if name and animal %}
                            <div>Say hello to {{ name }} the brave & noble {{ animal }}!</div>
                            <a href="{{ path('app_turbo') }}"><twig:ux:icon name="arrow-left" /> Back</a>
                        {% else %}
                            <div class="mb-4">Build yourself a new pet</div>
                            <form method="POST" novalidate>
                                <div class="flex justify-between">
                                    <div class="grow">
                                        {{ form_row(form.name, {
                                            attr: {placeholder: 'Enter a name'},
                                        }) }}
                                    </div>
                                    <div class="grow ms-2">
                                        {{ form_row(form.animal) }}
                                    </div>
                                </div>
                                <twig:Button variant="dark" type="submit" class="mt-12 w-full">Create!</twig:Button>
                            </form>
                        {% endif %}
                    {% endblock %}
                {% endembed %}
            </div>
        </div>
        {% endset %}
        <twig:Package:Section id="drive" tone="subtle">{{ turbo_drive }}</twig:Package:Section>

        {% set turbo_frames %}
        <div class="grid grid-cols-12 gap-x-6">
            <div class="col-span-12 md:col-span-6">
                <div class="md:px-12">
                    <twig:Package:SectionHeading title="Turbo <strong>Frames</strong>.">
                        Decompose complex pages into different parts that load and behave independently. Try it - it's smooth.
                    </twig:Package:SectionHeading>
                    <div class="rounded-md border bg-surface p-4">
                        <p class="m-0 text-sm leading-6">
                            The frame displays just part of the full page from
                            <a href="{{ path('app_turbo_todo_list') }}">{{ url('app_turbo_todo_list') }}</a>.
                            All link clicks and form submits stay <em>inside</em> the frame.
                            <twig:ux:icon name="arrow-right" />
                        </p>
                    </div>
                    {% set frames_docs = [
                        {title: 'Turbo Frames', url: turbo_docs_url ~ '#turbo-frames'},
                        {title: 'Frame requests', url: turbo_docs_url ~ '#detecting-turbo-frame-requests'},
                        {title: 'Minimal frame layout', url: turbo_docs_url ~ '#minimal-frame-layout'},
                    ] %}
                    <twig:DocumentationLinks
                        :links="frames_docs"
                        label="Documentation for Turbo Frames"
                    />
                </div>
            </div>
            <div class="col-span-12 md:col-span-6">
                {% embed 'ux_packages/_package_demo.html.twig' %}
                    {% block title %}
                        Turbo Frames Demo
                    {% endblock %}
                    {% block content %}
                        <turbo-frame
                            id="daily-todos"
                            src="{{ path('app_turbo_todo_list') }}"
                        ></turbo-frame>
                    {% endblock %}
                {% endembed %}
            </div>
        </div>
        {% endset %}
        <twig:Package:Section id="frames" tone="default">{{ turbo_frames }}</twig:Package:Section>

        {% set turbo_turbo_streams %}
        <div class="grid grid-cols-12 gap-x-6">
            <div class="col-span-12 md:col-span-6 md:order-2">
                <div class="md:px-12">
                    <twig:Package:SectionHeading title="Turbo <strong>Streams</strong>.">
                        Deliver page updates - to <em>any</em> elements on your page -
                        directly from Symfony. Add Mercure to do this for <em>any</em>
                        users on your site, in real-time.
                    </twig:Package:SectionHeading>
                    <div class="rounded-md border bg-surface p-4">
                        <p class="m-0 text-sm leading-6">
                            <twig:ux:icon name="arrow-left" />
                            Chat with someone else viewing this page (or open a
                            2nd browser tab to talk to yourself)!
                        </p>
                    </div>
                    {% set streams_docs = [
                        {title: 'Stream responses', url: turbo_docs_url ~ '#turbo-stream-responses'},
                        {title: 'Stream actions', url: turbo_docs_url ~ '#stream-messages-and-actions'},
                    ] %}
                    <twig:DocumentationLinks
                        :links="streams_docs"
                        label="Documentation for Turbo Streams"
                    />
                </div>
            </div>
            <div class="col-span-12 md:col-span-6 demo-chat">
                <turbo-frame id="turbo-chat" src="{{ path('app_turbo_chat_frame') }}" loading="lazy">
                    Loading the chat...
                </turbo-frame>
            </div>
        </div>
        {% endset %}
        <twig:Package:Section id="turbo-streams" tone="subtle">{{ turbo_turbo_streams }}</twig:Package:Section>

        <div class="fixed top-1/2 right-4 z-20 -translate-y-1/2">
            <a
                href="#turbo-streams"
                class="grid size-12 place-items-center rounded-full bg-(--package-accent) text-(--package-accent-ink) shadow-lg transition-transform duration-200 hover:scale-105"
                aria-label="Open the Turbo Streams chat demo"
            >
                <twig:ux:icon name="comment" class="size-5" />
            </a>
            <turbo-frame
                id="turbo-chat-count"
                src="{{ path('app_turbo_chat_frame') }}"
                class="pointer-events-none absolute -top-1 -right-1"
            ></turbo-frame>
        </div>

{% endblock %}
