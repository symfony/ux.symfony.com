{% props href, badge = null, hideOnCramped = false %}
<a
    href="{{ href }}"
    class="relative text-center font-title text-sm font-medium leading-[1.45] whitespace-nowrap max-nav:self-center opacity-90 transition-all duration-250 hover:opacity-100{{ hideOnCramped ? ' nav:max-nav-wide:hidden' }}"
>
    {%- if badge %}<twig:AppNav:Badge text="{{ badge }}" />{% endif -%}
    {%- block content %}{% endblock -%}
</a>
