{% macro bar(width = '65%', height = 8) %}<span class="ph block h-[var(--ph,8px)] w-[var(--pw,65%)] max-w-full shrink-0 rounded-[99px] bg-[var(--fill)] [transition:width_.25s,background-color_.25s] motion-reduce:transition-none" style="--pw: {{ width }}; --ph: {{ height }}px" aria-hidden="true"></span>{% endmacro %}
{% macro icon(name) %}
    <svg class="size-[18px] shrink-0 fill-none stroke-current stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        {% if name == 'heart' %}<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>
        {% elseif name == 'cross' %}<path d="m7 7 10 10M7 17 17 7"/>
        {% endif %}
    </svg>
{% endmacro %}
{% macro control() %}inline-flex cursor-pointer items-center justify-center gap-[10px] rounded-[var(--control-radius,6px)] border-[length:var(--control-border-width,1px)] border-solid border-[var(--line)] bg-[var(--control-bg,transparent)] px-[var(--control-px,9px)] py-[var(--control-py,9px)] text-inherit [&:hover]:bg-[#ffffff08] focus-visible:outline-2 focus-visible:outline-[var(--ink)] focus-visible:outline-offset-[3px] disabled:cursor-default disabled:opacity-40{% endmacro %}
