{#- Colour tokens every package page reads: a pastel for the hero, a deep ink for the text on it, and a mid tone readable on the body background. -#}
{%- set color = color|default(package.color) -%}
--color-accent: {{ color }}; --package-accent: oklch(from {{ color }} 0.74 calc(c * 0.85) h); --package-accent-ink: oklch(from {{ color }} 0.28 calc(c * 0.5) h); --package-primary-text: oklch(from {{ color }} 0.5 calc(c * 0.9) h);
