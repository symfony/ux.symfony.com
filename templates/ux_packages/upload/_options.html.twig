{# An optional introduction turns the three examples into a two-by-two grid. #}
{% set with_intro = intro is defined and intro|trim is not empty %}
<div class="UploadOptions grid gap-x-12 gap-y-14 lg:gap-y-0 {{ with_intro ? 'lg:grid-cols-2' : 'lg:grid-cols-3' }}">
    {% if with_intro %}
        <div class="min-w-0 lg:row-span-4 lg:mb-16">{{ intro|raw }}</div>
    {% endif %}
    {% for item in items %}
        <article class="flex min-w-0 flex-col lg:row-span-4 lg:grid lg:grid-rows-subgrid {{ with_intro and loop.first ? 'lg:mb-16' : '' }}">
            <twig:ux:icon name="{{ item.icon }}" class="size-8 fill-none stroke-[1.6] text-(--package-primary-text)" aria-hidden="true" />
            <h3 class="m-0 mt-6 font-title text-2xl font-bold leading-tight tracking-[-.02em] text-balance [&_strong]:text-(--package-primary-text)">{{ item.title|raw }}</h3>
            <p class="m-0 mt-4 leading-[1.7] text-body-text/80 text-balance">{{ item.description|raw }}</p>
            <twig:CodeBlockInline :code="item.code" :copyCode="item.copyCode|default(null)" language="{{ item.language|default('php') }}" class="mt-8" />
        </article>
    {% endfor %}
</div>
