{% set image_html %}{{ include(template)|trim }}{% endset %}
{% set pretty_html = image_html|replace({
    '<img src=': '<img\n    src=',
    ' alt=': '\n    alt=',
    ' srcset=': '\n    srcset=',
    ' sizes=': '\n    sizes=',
    ' loading=': '\n    loading=',
    ' fetchpriority=': '\n    fetchpriority=',
    ' width=': '\n    width=',
    ' height=': '\n    height=',
    ' style=': '\n    style=',
    ', https://': ',\n        https://',
}) %}

<div class="flex flex-col md:flex-row gap-6 py-6 border-b border-n-200 first:pt-0 last:pb-0 last:border-b-0"
     data-image-demo
     data-controller="image-demo"
>
    <div class="md:w-[480px] shrink-0">
        <div class="text-xs uppercase tracking-wide text-muted mb-2">{{ label }}</div>
        {{ image_html }}
        <p class="mt-3 flex flex-wrap items-center gap-2 text-sm">
            <span data-image-demo-original>{{ (original_size / 1000000)|number_format(1) }} MB JPEG</span>
            <twig:ux:icon name="lucide:arrow-right" class="size-4" aria-hidden="true"/>
            <strong data-image-demo-target="delivered">measured in your browser</strong>
        </p>
    </div>
    <div class="min-w-0 flex-1 flex flex-col gap-4">
        <twig:CodeBlockInline :code="source(template)|trim" language="twig" :filename="'templates/' ~ template" />
        <twig:CodeBlockInline :code="pretty_html" language="html" filename="Rendered HTML" />
    </div>
</div>
