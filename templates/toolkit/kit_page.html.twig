{% extends 'base.html.twig' %}

{% block content %}
    <div class="pt-20"></div>

    <div class="max-w-[1140px] xl:max-w-[1280px] 2xl:max-w-[1440px] mx-auto lg:pt-6 grid grid-cols-1 lg:grid-cols-[180px_1fr] gap-8 px-4 lg:px-0">
        <div class="hidden lg:block">
            {{ include('toolkit/_kit_aside.html.twig') }}
        </div>

        <div class="min-w-0">
            <div class="xl:hidden sticky top-0 z-9 -mx-4 mb-6 px-4 py-3 bg-body/85 backdrop-blur border-b border-border flex items-center gap-3">
                {{ include('toolkit/_kit_mobile_menu.html.twig') }}
                {% block kit_toolbar %}{% endblock %}
            </div>

            {% block kit_main %}{% endblock %}
        </div>
    </div>
{% endblock %}
