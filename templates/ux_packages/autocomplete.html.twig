{% extends 'ux_packages/package.html.twig' %}

{% block package_header %}
    {% component PackageHeader with {
        package: 'autocomplete',
        eyebrowText: 'Smart Form Controls',
    } %}
        {% block title_header %}
            Ajax-Powered Autocomplete
            <em>&lt;select&gt;</em>
        {% endblock %}

        {% block sub_content %}
            Breathe life into <code>EntityType</code> and
            <code>ChoiceType</code> fields
            with <a href="https://tom-select.js.org/" rel="noopener nofollow noreferrer">Tom Select</a>
            and a sprinkle of Ajax.
        {% endblock %}
    {% endcomponent %}
{% endblock %}

{% block package_features %}
    {% set autocomplete_features = [
        {
            icon: 'lucide:search',
            title: 'Search as you <strong>type</strong>',
            description: 'Query the server without leaving the form.',
        },
        {
            icon: 'lucide:text-cursor-input',
            title: 'A real <strong>form type</strong>',
            description: 'Drop it into any Symfony form.',
        },
        {
            icon: 'lucide:database',
            title: 'Doctrine <strong>aware</strong>',
            description: 'Point it at an entity and it queries for you.',
        },
        {
            icon: 'lucide:list-plus',
            title: 'Create on the <strong>fly</strong>',
            description: 'Let users add a value that does not exist yet.',
        },
        {
            icon: 'lucide:layers-2',
            title: 'Multiple <strong>selection</strong>',
            description: 'Tags, grouping and dependent fields.',
        },
    ] %}
    <twig:FeaturesCluster
        :items="autocomplete_features"
        title="What Autocomplete gives you"
        titleId="autocomplete-overview-title"
    />
{% endblock %}

{% block package_highlights %}
    {% set ac_option %}$builder->add('food', EntityType::class, [
    'class' => Food::class,
    'autocomplete' => true,
]);{% endset %}
    {% set ac_field %}#[AsEntityAutocompleteField]
class FoodField extends AbstractType
{
    public function configureOptions(
        OptionsResolver $resolver,
    ): void {
        $resolver->setDefaults([
            'class' => Food::class,
        ]);
    }
}{% endset %}
    {% set ac_create %}$resolver->setDefaults([
    'class' => Food::class,
    'allow_options_create' => true,
]);{% endset %}

    <twig:Package:Highlights
        eyebrow="From a select to a search field"
        title="Where the <strong>options</strong> come from."
        intro="A plain select ships every row to the browser. Autocomplete keeps them on the server and fetches only what the visitor is looking for."
        :items="[
            {
                icon: 'lucide:toggle-right',
                title: 'One <strong>option</strong> to switch it on',
                description: 'Add autocomplete to an existing EntityType or ChoiceType and the field becomes searchable.',
                code: ac_option,
                language: 'php',
            },
            {
                icon: 'lucide:database',
                title: 'Its own <strong>endpoint</strong>',
                description: 'The attribute registers a dedicated controller, so the browser queries the database instead of downloading it.',
                code: ac_field,
                language: 'php',
            },
            {
                icon: 'lucide:list-plus',
                title: 'Values that do not <strong>exist yet</strong>',
                description: 'allow_options_create lets a visitor type something new. Your code decides whether to persist it.',
                code: ac_create,
                language: 'php',
            },
        ]"
    />
{% endblock %}

{% block code_block_left %}
    <twig:CodeBlock filename="src/Form/TimeForAMealForm.php" height="300px" />
{% endblock %}

{% block code_block_right %}
    <twig:CodeBlock filename="src/Form/FoodAutocompleteField.php" height="300px" />
{% endblock %}

{% block demo_title %}UX Autocomplete{% endblock %}

{% block demo_content %}
    {# The frame is used just to keep the form submit all in one place: it feels nice #}
    <turbo-frame id="autocomplete-demo-form">
        {% for message in app.flashes('autocomplete_success') %}
            <twig:Alert variant="success" data-turbo-cache="false">{{ message }}</twig:Alert>
        {% endfor %}

        {{ form_start(form) }}
            {{ form_row(form.foods, {attr: {class: 'mb-3'}}) }}

            {{ form_row(form.name, {attr: {class: 'mb-3'}}) }}

            <twig:Button variant="primary" type="submit">Let's Nom!</twig:Button>
        {{ form_end(form) }}
    </turbo-frame>
{% endblock %}
