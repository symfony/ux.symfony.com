{% extends 'base.html.twig' %}

{% set meta = {
    title: 'All Packages',
    description: 'Symfony UX: a treasure chest of packages to solve your frontend problems',
    canonical: url('app_packages'),
} %}

{% block content %}
<div class="pt-20">
    <div class="max-w-[1400px] mx-auto px-6 pt-6 md:px-12">
        <h1 class="text-center mt-12">UX Packages</h1>
        <p class="text-center mt-2 mb-12">A treasure chest of bundles, components and packages</p>
    </div>
</div>

<div class="max-w-[1400px] mx-auto px-6 pt-6 md:px-12">
    {% block list %}
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {% for package in packages %}
                <twig:PackageBox package="{{ package }}" titleTag="h2" />
            {% endfor %}
        </div>
    {% endblock %}
</div>

<h2 class="text-center mt-12">Deprecated and removed packages</h2>
<p class="text-center mt-2 mb-12">Packages that are still available, but not maintained anymore...</p>
<div class="max-w-[1400px] mx-auto px-6 pt-6 md:px-12">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {% for package in removed_packages %}
                <twig:PackageBox package="{{ package }}" titleTag="h2" />
            {% endfor %}
        </div>
</div>
{% endblock %}

{% block aside %}
    {{ include('_aside.html.twig') }}
{% endblock %}
