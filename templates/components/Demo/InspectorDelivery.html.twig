{% import 'ux_packages/inspector/_shapes.html.twig' as shape %}
<div {{ attributes }} class="delivery grid w-full min-w-0 justify-self-stretch gap-[15px]" data-demo="delivery">
    {{ shape.bar('48%', 6) }}
    <button type="button" class="{{ shape.control() }} justify-between [--control-px:8px] [--control-py:10px] aria-pressed:[&_.selection-dot]:border-current aria-pressed:[&_.selection-dot]:bg-current" data-demo="delivery-toggle" aria-label="Express delivery" aria-pressed="{{ express ? 'true' : 'false' }}" data-action="live#action" data-live-action-param="toggle">
        {{ shape.bar('58%', 6) }}<span class="selection-dot size-[10px] rounded-full border border-[#82949e]" aria-hidden="true"></span>
    </button>
</div>
