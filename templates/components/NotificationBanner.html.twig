{% set animation_class = variant == 'animated' ? 'animation-drop-out' : '' %}

<article
    {{ attributes.defaults({
        class: 'NotificationBanner flex min-h-0 min-w-0 flex-col items-center rounded-xl bg-n-800 px-5 py-5 text-center ring-1 ring-inset ring-white/8 lg:px-7 lg:py-7 ' ~ animation_class,
    }) }}
>
    <twig:ux:icon name="{{ icon }}" class="LiveDemoIcon mb-4 size-12 shrink-0 text-pink-300 lg:mb-5 lg:size-14" />

    <h4 class="mb-0 text-lg font-semibold text-n-100 lg:text-xl">{{ title }}</h4>
    <p class="mt-1.5 max-w-[18rem] text-xs leading-4 text-n-400 lg:mt-2 lg:text-sm lg:leading-5">{{ message }}</p>

    <twig:Button
        variant="primary"
        size="md"
        class="mt-auto shrink-0 whitespace-nowrap rounded-full border-black bg-black px-4 py-2 text-xs font-semibold text-white hover:bg-n-900 hover:opacity-100 lg:px-6 lg:py-2.5 lg:text-sm"
        aria-label="{{ title }}"
        data-action="live#action"
        data-live-action-param="{{ action }}"
        data-loading="addAttribute(disabled)"
    >{{ buttonLabel }}</twig:Button>
</article>
