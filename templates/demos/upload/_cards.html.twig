{#- The Upload demos, in reading order -#}
{% set upload_demos = [
    {
        name: 'Keep Files on Errors',
        description: 'A validation error empties a file input. Not this one.',
        image: 'images/live_demo/upload-keep-files.png',
        route: 'app_demo_upload_keep_files',
        tags: ['upload', 'form', 'validation'],
    },
    {
        name: 'Upload with Turbo',
        description: 'Save an album from a Turbo Frame. A Turbo Stream adds it to the page.',
        image: 'images/live_demo/upload-turbo.png',
        route: 'app_demo_upload_turbo',
        tags: ['upload', 'Turbo', 'gallery'],
    },
    {
        name: 'Live Avatar',
        description: 'Update a LiveComponent when the upload completes.',
        image: 'images/live_demo/upload-live-avatar.png',
        route: 'app_demo_upload_live_avatar',
        tags: ['upload', 'LiveComponent', 'avatar'],
    },
    {
        name: 'Simple & Enhanced Input',
        description: 'The compact field: a native input, or a list with previews and progress.',
        image: 'images/live_demo/upload-input.png',
        route: 'app_demo_upload_input',
        tags: ['upload', 'compact', 'preview'],
    },
    {
        name: 'Dropzone & Card Grid',
        description: 'A large drop target, with a file list or a grid of image cards.',
        image: 'images/live_demo/upload-dropzone.png',
        route: 'app_demo_upload_dropzone',
        tags: ['upload', 'dropzone', 'gallery'],
    },
    {
        name: 'Resumable Large Files',
        description: 'Pause a transfer, reload the page, and pick up where it stopped.',
        image: 'images/live_demo/upload-resumable.png',
        route: 'app_demo_upload_resumable',
        tags: ['upload', 'chunks', 'resume'],
    },
] %}

{# On a demo page: only the demo before and the one after, the list read as a loop #}
{% if around is defined %}
    {% set routes = upload_demos|map(demo => demo.route) %}
    {% set count = routes|length %}
    {% set position = routes|keys|filter(key => routes[key] == around)|first %}
    {% set upload_demos = [upload_demos[(position - 1 + count) % count], upload_demos[(position + 1) % count]] %}
{% endif %}

{% set with_grid = grid is not defined or grid %}

{% if with_grid %}
<div class="DemoCardGrid {{ class|default('') }}">
{% endif %}
    {% for demo in upload_demos %}
        {% if around is defined %}<div class="flex max-w-[380px]">{% endif %}
        <twig:Card
            name="{{ demo.name }}"
            description="{{ demo.description }}"
            image="{{ asset(demo.image) }}"
            url="{{ path(demo.route) }}"
            :tags="demo.tags"
            :showTags="show_tags is defined ? show_tags : true"
        />
        {% if around is defined %}</div>{% endif %}
    {% endfor %}
{% if with_grid %}
</div>
{% endif %}
